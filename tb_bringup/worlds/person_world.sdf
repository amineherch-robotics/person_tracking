<?xml version="1.0"?>
<!--
  Monde de test pour le suivi de personne.
  Robot spawn a l'origine, oriente vers +x. Une personne (actor) marche en boucle
  sur un rectangle 1 m x 2 m situe entre 2.5 et 3.5 m devant le robot, a ~0.16 m/s.
  Le robot reste immobile en Phase 0 : la personne doit rester dans le champ de la camera.
-->
<sdf version="1.9">
  <world name="person_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-3.0 -3.5 3.5 0 0.55 0.8</pose>
      </camera>
    </gui>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!-- Piece interieure 10 m x 8 m (hypothese de fonctionnement : interieur) -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>2 4 1 0 0 0</pose><geometry><box><size>10 0.1 2</size></box></geometry></collision>
        <visual name="north_v"><pose>2 4 1 0 0 0</pose><geometry><box><size>10 0.1 2</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="south_c"><pose>2 -4 1 0 0 0</pose><geometry><box><size>10 0.1 2</size></box></geometry></collision>
        <visual name="south_v"><pose>2 -4 1 0 0 0</pose><geometry><box><size>10 0.1 2</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="east_c"><pose>7 0 1 0 0 0</pose><geometry><box><size>0.1 8 2</size></box></geometry></collision>
        <visual name="east_v"><pose>7 0 1 0 0 0</pose><geometry><box><size>0.1 8 2</size></box></geometry>
          <material><ambient>0.7 0.75 0.8 1</ambient><diffuse>0.7 0.75 0.8 1</diffuse></material></visual>
        <collision name="west_c"><pose>-3 0 1 0 0 0</pose><geometry><box><size>0.1 8 2</size></box></geometry></collision>
        <visual name="west_v"><pose>-3 0 1 0 0 0</pose><geometry><box><size>0.1 8 2</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstacles statiques : donnent des echos LiDAR et du contexte visuel -->
    <model name="box_1">
      <static>true</static>
      <pose>5 2.5 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.6 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.6 0.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_1">
      <static>true</static>
      <pose>5.5 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.6 1</ambient><diffuse>0.2 0.4 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Balle de tennis (Phase 1) : diametre 6.7 cm, jaune-vert fluo.
         Pilotable comme un petit robot : VelocityControl applique la vitesse recue sur
         /model/tennis_ball/cmd_vel (pont ROS : /ball/cmd_vel, joystick : ros2 run tb_bringup ball_joystick).
         Sans gravite et 2 mm au-dessus du sol : elle glisse sans rouler ni frotter. -->
    <model name="tennis_ball">
      <pose>2.0 0.6 0.0355 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.058</mass>
          <inertia>
            <ixx>2.6e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.6e-5</iyy><iyz>0</iyz><izz>2.6e-5</izz>
          </inertia>
        </inertial>
        <collision name="c"><geometry><sphere><radius>0.0335</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.0335</radius></sphere></geometry>
          <material><ambient>0.8 1.0 0.0 1</ambient><diffuse>0.8 1.0 0.0 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/tennis_ball/cmd_vel</topic>
      </plugin>
    </model>

    <!-- Personne cible : actor anime (mesh Fuel telecharge au premier lancement) -->
    <actor name="person_1">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <!-- Rectangle (2.5,-1) -> (2.5,1) -> (3.5,1) -> (3.5,-1), ~0.16 m/s (marche lente, hypothese du CdC ;
             le robot est limite a 0.15 m/s), 2.5 s par virage -->
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>2.5 -1.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>12.5</time><pose>2.5 1.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>15</time><pose>2.5 1.0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>21.25</time><pose>3.5 1.0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>23.75</time><pose>3.5 1.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>36.25</time><pose>3.5 -1.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>38.75</time><pose>3.5 -1.0 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>45</time><pose>2.5 -1.0 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>47.5</time><pose>2.5 -1.0 1.0 0 0 4.7124</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Personnes 2 et 3 : croisent la trajectoire de la personne 1, pour tester le suivi multi-objets
         (memes IDs malgre les croisements et les occlusions). Meme modele 3D que la personne 1. -->
    <actor name="person_2">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <!-- Aller-retour sur une ligne y = 0, de x = 2.0 a 4.5 (~0.2 m/s) : passe devant puis derriere la personne 1 -->
        <trajectory id="1" type="walk">
          <waypoint><time>0</time><pose>4.5 0.0 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>12.5</time><pose>2.0 0.0 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>15</time><pose>2.0 0.0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>27.5</time><pose>4.5 0.0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>30</time><pose>4.5 0.0 1.0 0 0 3.1416</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="person_3">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <!-- Aller-retour sur une ligne x = 5.0, de y = -2.5 a 2.5 (~0.25 m/s), au fond de la piece -->
        <trajectory id="2" type="walk">
          <waypoint><time>0</time><pose>5.0 2.5 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>20</time><pose>5.0 -2.5 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>22.5</time><pose>5.0 -2.5 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>42.5</time><pose>5.0 2.5 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>45</time><pose>5.0 2.5 1.0 0 0 -1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>
